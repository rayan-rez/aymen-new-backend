{
  "name": "aymen-new-backend",
  "version": "1.0.0",
  "description": "A scalable and secure backend API built with Express.js for managing real estate operations and property development projects.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "prebuild": "npm run clean",
    "build": "npm run clean && babel src --out-dir dist --extensions \".ts\" --source-maps --copy-files --no-copy-ignored",
    "build:compile": "babel src --out-dir dist --extensions \".ts\" --source-maps --copy-files --no-copy-ignored",
    "build:copy": "copyfiles -u 1 \"src/**/*.json\" \"src/**/*.env.example\" dist/",
    "build:tsc": "tsc",
    "build:prod": "npm run clean && npm run build:tsc && npm run build:compile",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "jest --verbose --runInBand --logHeapUsage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "clean": "rm -rf dist",
    "migrate:make": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex migrate:make --knexfile knexfile.ts -x ts",
    "migrate:latest": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex migrate:status --knexfile knexfile.ts",
    "seed:make": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex seed:make --knexfile knexfile.ts -x ts",
    "seed:run": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex seed:run --knexfile knexfile.ts",
    "seed:run:prod": "NODE_ENV=production ts-node -r tsconfig-paths/register ./node_modules/.bin/knex seed:run --knexfile knexfile.ts",
    "seed:specific": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex seed:run --knexfile knexfile.ts --specific",
    "db:setup": "npm run migrate:latest && npm run seed:run",
    "db:reset": "npm run migrate:rollback && npm run migrate:latest",
    "db:fresh": "npm run migrate:rollback && npm run migrate:latest && npm run seed:run",
    "docker:build": "docker compose build",
    "docker:build:fresh": "docker compose build --no-cache",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f app",
    "docker:logs:mysql": "docker compose logs -f mysql",
    "docker:restart": "docker compose restart app",
    "docker:rebuild": "npm run docker:down && npm run docker:build && npm run docker:up",
    "docker:rebuild:fresh": "npm run docker:down:clean && npm run docker:build:fresh && npm run docker:up",
    "docker:migrate": "docker exec aymen-backend npm run migrate:latest",
    "docker:migrate:rollback": "docker exec aymen-backend npm run migrate:rollback",
    "docker:migrate:status": "docker exec aymen-backend npm run migrate:status",
    "docker:seed": "docker exec aymen-backend npm run seed:run",
    "docker:seed:specific": "docker exec aymen-backend npm run seed:specific --",
    "docker:db:setup": "npm run docker:migrate && npm run docker:seed",
    "docker:db:fresh": "npm run docker:down:clean && npm run docker:up && npm run docker:wait && npm run docker:db:setup",
    "docker:wait": "echo 'Waiting for MySQL...' && sleep 15",
    "docker:shell": "docker exec -it aymen-backend sh",
    "docker:mysql": "docker exec -it aymen-mysql mysql -u root -proot aymen_db",
    "docker:env:check": "docker exec aymen-backend sh -c 'echo DB_HOST=$DB_HOST && echo DB_PORT=$DB_PORT && echo DB_NAME=$DB_NAME'",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "real-estate",
    "api",
    "express",
    "typescript"
  ],
  "author": "Rayan Rezougui",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayan-rez/aymen-new-backend.git"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "mysql2": "^3.15.2",
    "nodemailer": "^6.10.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/knex": "^0.15.2",
    "@types/node": "^24.8.1",
    "@types/nodemailer": "^6.4.20",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
