{
  "name": "aymen-new-backend",
  "version": "1.0.0",
  "description": "A scalable and secure backend API built with Express.js for managing real estate operations and property development projects.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && babel src --out-dir dist --extensions \".ts\" --copy-files",
    "start": "node dist/index.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js -x ts",
    "migrate:latest": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "seed:make": "knex seed:make --knexfile knexfile.js -x ts",
    "seed:run": "knex seed:run --knexfile knexfile.js",
    "db:setup": "npm run migrate:latest && npm run seed:run",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "real-estate",
    "api",
    "express",
    "typescript"
  ],
  "author": "Rayan Rezougui",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayan-rez/aymen-new-backend.git"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "mysql2": "^3.15.2",
    "nodemailer": "^6.10.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/knex": "^0.15.2",
    "@types/node": "^24.8.1",
    "@types/nodemailer": "^6.4.20",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
