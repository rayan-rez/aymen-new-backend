{
  "name": "aymen-new-backend",
  "version": "1.0.0",
  "description": "A scalable and secure backend API built with Express.js for managing real estate operations and property development projects.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && babel src --out-dir dist --extensions \".ts\" --copy-files",
    "start": "node dist/index.js",
    "migrate:make": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex migrate:make --knexfile knexfile.ts -x ts",
    "migrate:latest": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex migrate:rollback --knexfile knexfile.ts",
    "seed:make": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex seed:make --knexfile knexfile.ts -x ts",
    "seed:run": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex seed:run --knexfile knexfile.ts",
    "db:setup": "npm run migrate:latest && npm run seed:run",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest --verbose --runInBand --logHeapUsage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "archive:all": "ts-node src/scripts/archive-data.ts all",
    "archive:table": "ts-node src/scripts/archive-data.ts table",
    "archive:purge": "ts-node src/scripts/archive-data.ts purge",
    "archive:verify": "ts-node src/scripts/archive-data.ts verify",
    "archive:stats": "ts-node src/scripts/archive-data.ts stats",
    "partition:create": "ts-node src/scripts/manage-partitions.ts create",
    "partition:drop": "ts-node src/scripts/manage-partitions.ts drop",
    "partition:stats": "ts-node src/scripts/manage-partitions.ts stats",
    "partition:health": "ts-node src/scripts/manage-partitions.ts health",
    "partition:optimize": "ts-node src/scripts/manage-partitions.ts optimize",
    "partition:auto": "ts-node src/scripts/manage-partitions.ts auto-maintain",
    "maintain:monthly": "npm run partition:auto && npm run archive:all && npm run archive:verify",
    "maintain:weekly": "npm run partition:health && npm run partition:stats"
  },
  "keywords": [
    "real-estate",
    "api",
    "express",
    "typescript"
  ],
  "author": "Rayan Rezougui",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayan-rez/aymen-new-backend.git"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "knex": "^3.1.0",
    "mysql2": "^3.15.2",
    "nodemailer": "^6.10.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/knex": "^0.15.2",
    "@types/node": "^24.8.1",
    "@types/nodemailer": "^6.4.20",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-jest": "^30.2.0",
    "eslint": "^9.38.0",
    "express": "^5.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
