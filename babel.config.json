{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "20"
        },
        "modules": "commonjs"
      }
    ],
    "@babel/preset-typescript"
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./src"],
        "alias": {
          "@": "./src",
          "@services": "./src/services",
          "@middlewares": "./src/middlewares",
          "@utils": "./src/utils",
          "@models": "./src/models",
          "@controllers": "./src/controllers",
          "@constants": "./src/constants",
          "@/types": "./src/types",
          "@tests": "./src/__tests__"
        },
        "extensions": [".ts", ".js", ".json"]
      }
    ]
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "node_modules"
  ],
  "env": {
    "test": {
      "plugins": ["babel-plugin-jest-hoist"]
    }
  }
}