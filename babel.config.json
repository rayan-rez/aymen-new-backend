{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "18"
        }
      }
    ],
    "@babel/preset-typescript"
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./dist"],
        "alias": {
          "@": "./dist",
          "@services": "./dist/services",
          "@middlewares": "./dist/middlewares",
          "@utils": "./dist/utils",
          "@models": "./dist/models",
          "@controllers": "./dist/controllers",
          "@constants": "./dist/constants",
          "@assets": "./dist/assets",
          "@/types": "./dist/types",
          "@tests": "./dist/__tests__"
        }
      }
    ]
  ]
}