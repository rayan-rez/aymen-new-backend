
# Server
NODE_ENV=test
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=aymen_test

# Old Database
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3306
OLD_DB_USER=root
OLD_DB_PASSWORD=root
OLD_DB_NAME=aymen-database

# Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test
SMTP_PASS=test
EMAIL_FROM=test@example.com
EMAIL_FROM_NAME=Aymen Test
CONTACT_EMAIL=contact@test.com

# CORS
ALLOWED_ORIGINS=*

# File Upload
MAX_FILE_SIZE=1048576
UPLOAD_DIR=test_uploads

# YouTube API Configuration
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-channel-id

# Test Settings
SUPPRESS_TEST_LOGS=false