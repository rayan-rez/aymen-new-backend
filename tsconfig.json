{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "noEmit": true // Important: Babel will handle transpilation, TypeScript just type-checks
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "knexfile.js"]
}
