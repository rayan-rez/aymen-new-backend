{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDirs": [
      "./src",
      "./__tests__"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@services/*": ["src/services/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@utils/*": ["src/utils/*"],
      "@models/*": ["src/models/*"],
      "@models": ["src/models/index.ts"],
      "@controllers/*": ["src/controllers/*"],
      "@constants/*": ["src/constants/*"],
      "@assets/*": ["src/assets/*"],
      "@/types/*": ["src/types/*"],
      "@tests/*": ["__tests__/*"]
    }
  },
  "include": ["src/**/*", "scripts/archive-data.ts", "scripts/manage-partition.ts", "scripts/verify-migration.ts","__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}